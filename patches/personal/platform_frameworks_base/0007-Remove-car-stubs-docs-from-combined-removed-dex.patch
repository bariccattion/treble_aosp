From c8bc9afa5d5a7ab36602d8852a7dfd05843128d1 Mon Sep 17 00:00:00 2001
From: Bariccatti <bariccatti@gmail.com>
Date: Sat, 25 Apr 2026 12:55:50 -0300
Subject: [PATCH] Remove car stubs docs from combined-removed-dex

The TrebleDroid build removes packages/services/Car via remove.xml, which makes android.car-stubs-docs and android.car-system-stubs-docs undefined. Remove these references to fix the Soong build error.
---
 api/Android.bp | 2 --
 1 file changed, 2 deletions(-)

diff --git a/api/Android.bp b/api/Android.bp
index 698f4ee..063e9eb 100644
--- a/api/Android.bp
+++ b/api/Android.bp
@@ -324,8 +324,6 @@ java_genrule {
         "//frameworks/base/boot",
     ],
     srcs: [
-        ":android.car-stubs-docs{.removed-api.txt}",
-        ":android.car-system-stubs-docs{.removed-api.txt}",
         ":frameworks-base-api-removed.txt",
         ":frameworks-base-api-system-removed.txt",
     ],
-- 
2.53.0.windows.3
