From: Bariccatti <bariccatti@gmail.com>
Date: Sat, 25 Apr 2026 01:50:04 -0300
Subject: [PATCH] Properly expose GridCustomizationsProvider

---
 AndroidManifest-common.xml | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/AndroidManifest-common.xml b/AndroidManifest-common.xml
index c28ca1b..4699078 100644
--- a/AndroidManifest-common.xml
+++ b/AndroidManifest-common.xml
@@ -127,8 +127,10 @@
          -->
         <provider
             android:name="com.android.launcher3.graphics.LauncherCustomizationProvider"
-            android:authorities="${applicationId}.grid_control"
-            android:exported="true" />
+            android:authorities=".grid_control"
+            android:exported="true"
+            android:writePermission=".permission.WRITE_SETTINGS"
+            android:readPermission=".permission.READ_SETTINGS"/>
 
         <!--
         The settings activity. To extend point settings_fragment_name to appropriate fragment class
